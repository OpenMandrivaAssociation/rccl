+// x86_64 flushes with a direct load. Other arches call this. The HIP path
+// maps the buffer host-visible, so a memcpy is the PCI read. The gdrcopy
+// definition below is not compiled for HIP.
+static ncclResult_t ncclGdrCudaRead(void* gdrHandle, void* dst, const void* src, size_t size) {
+  (void)gdrHandle;
+  memcpy(dst, src, size);
+  return ncclSuccess;
+}
