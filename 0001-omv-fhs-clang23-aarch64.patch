FHS / aarch64 / include-order fixes for RCCL 10.1.

nvtx.h and nvtx_stub.h both defined struct nccl_domain.
rccl_common.h used NCCL_NUM_* before nccl_tuner.h.
ipc_init.cu used std::cerr without iostream.
init.cc aarch64 cpuid guards are already upstream.

diff -Nurp a/src/algorithms/dda/ipc/ipc_init.cu b/src/algorithms/dda/ipc/ipc_init.cu
--- a/src/algorithms/dda/ipc/ipc_init.cu
+++ b/src/algorithms/dda/ipc/ipc_init.cu
@@ -15,6 +15,7 @@
 #include "algorithms/dda/ipc/ipc_mem_handler.h"
 
 #include <cuda_runtime.h>
+#include <iostream>
 
 using nccl_dda_detail::DdaIpcBarrierState;
 using nccl_dda_detail::ddaMaxNBlocksForScratch;
